#!/bin/sh
#
# Ubuntu Touch 24.04 (Halium 10) installer for Xiaomi Redmi 6 Pro (sakura)
# Flash from OrangeFox / TWRP. This replaces the boot image, so the phone boots Ubuntu
# Touch directly: no dual-boot menu, and Android stops booting until the saved boot image is
# flashed back. Only the rootfs images are stored as files in /data.
#
# Layout written by this script:
#   /dev/block/by-name/boot   <- Halium kernel + initramfs   (partitions/boot.img)
#   /data/rootfs.img          <- Ubuntu Touch rootfs         (images/rootfs.img.gz)
#   /data/android-rootfs.img  <- Halium 10 GSI               (images/android-rootfs.img)
#
# Everything is verified before anything is written, and the existing boot image is
# backed up to /sdcard so the phone can always be returned to Android.
#
# NOTE: nothing is unpacked into a second copy first. The big images are streamed straight
# out of the zip into their final file, so the installer needs only rootfs + GSI of free
# space in /data on top of the zip itself. v0.1.1 unpacked the zip into /data/sakura-ut-install
# before writing the same data again, which pushed peak usage ~1.5 GB higher than the number
# its own space check demanded, and died midway through the 4 GiB rootfs write with a single
# "No space left on device" line.
#
# NOTE: /tmp is a tmpfs of a few hundred MiB on this phone, so the payload is never staged
# there. Small metadata files only.

set -u

OUTFD="/proc/self/fd/$2"
ZIPFILE="$3"

# Written so a failed flash can always be diagnosed afterwards, even when recovery scrolls
# the on-screen log away. Set once /data is mounted.
LOG=""

log_line() {
    if [ -n "$LOG" ]; then
        printf '%s\n' "$*" >> "$LOG" 2>/dev/null || true
    fi
    return 0
}

ui_print() {
    echo "ui_print $*" > "$OUTFD" 2>/dev/null || true
    echo "ui_print" > "$OUTFD" 2>/dev/null || true
    log_line "$*"
}

die() {
    ui_print ""
    ui_print "! $*"
    ui_print "! Installation aborted."
    ui_print "! Full log: ${LOG:-the recovery log}"
    exit 1
}

ui_print "*********************************************"
ui_print " Ubuntu Touch 24.04 - Redmi 6 Pro (sakura)"
ui_print " Halium 10 / arm64 - recovery installer"
ui_print "*********************************************"
ui_print ""

# ---------------------------------------------------------------- device check
DEVICE="$(getprop ro.product.device 2>/dev/null)"
[ -z "$DEVICE" ] && DEVICE="$(getprop ro.build.product 2>/dev/null)"

MATCH=0
case "$DEVICE" in sakura|*sakura*) MATCH=1 ;; esac
if [ "$MATCH" -eq 0 ]; then
    grep -qi "sakura" /proc/cmdline && MATCH=1
fi
# Escape hatch for people whose recovery reports a different codename.
[ -e /tmp/sakura.force ] && MATCH=1

if [ "$MATCH" -eq 0 ]; then
    die "This package is for sakura (Redmi 6 Pro), but this device reports '$DEVICE'."
fi
ui_print "[*] Device check passed ($DEVICE)"

# ---------------------------------------------------------------- mount /data
mount /data 2>/dev/null || true
if [ ! -d /data/media ] && [ ! -d /data/lost+found ]; then
    mount -t ext4 /dev/block/by-name/userdata /data 2>/dev/null || true
fi
if [ ! -d /data/media ] && [ ! -d /data/lost+found ]; then
    die "/data is not mounted. In recovery, decrypt userdata (enter PIN/pattern) or format it as ext4, then retry."
fi

if [ -d /data/media/0 ]; then
    LOG="/data/media/0/sakura-ut-install.log"
else
    LOG="/data/sakura-ut-install.log"
fi
: > "$LOG" 2>/dev/null || LOG=""
log_line "installer: $(date -u +%Y-%m-%dT%H:%M:%SZ) zip=$ZIPFILE device=$DEVICE"
ui_print "[*] /data mounted"

# A read-only /data looks mounted but every write below would fail.
if ! printf '' >> /data/rootfs.img 2>/dev/null; then
    die "/data is not writable (read-only mount?). Remount it read-write in recovery and retry."
fi

WORK="/data/sakura-ut-install"
rm -rf "$WORK"
if ! mkdir -p "$WORK/partitions"; then
    die "Cannot create $WORK"
fi
# The exit status of the last command in an EXIT trap becomes the script's exit status.
# Save the real status and return it, so a failing cleanup cannot turn a good install into
# "aborted" (and a real failure is still reported).
cleanup() {
    rc=$?
    rm -rf "$WORK" 2>/dev/null || true
    return "$rc"
}
trap cleanup EXIT

ERR="$WORK/step.err"

# ---------------------------------------------------------------- space check
# Read the manifest straight out of the zip: the check has to run before anything is
# written, and the zip cannot be unpacked to read it.
BUILD_PROP_REL="META-INF/sakura/build.prop"
BUILD_PROP="$WORK/$BUILD_PROP_REL"
MANIFEST="$(unzip -p "$ZIPFILE" "$BUILD_PROP_REL" 2>/dev/null || true)"
ROOTFS_BYTES="$(printf '%s\n' "$MANIFEST" | sed -n 's/^sakura\.build\.rootfs_bytes=//p')"
# A missing or non-numeric value means the manifest cannot be trusted. Treat 0 the same
# way: it is what an exactly-4 GiB image looks like once gzip's 32-bit size field wraps,
# and believing it would under-check /data by the whole rootfs and die mid-write.
case "$ROOTFS_BYTES" in ''|*[!0-9]*) ROOTFS_BYTES=0 ;; esac
[ "$ROOTFS_BYTES" -gt 0 ] || ROOTFS_BYTES=4294967296
ANDROID_BYTES="$(printf '%s\n' "$MANIFEST" | sed -n 's/^sakura\.build\.android_rootfs_bytes=//p')"
case "$ANDROID_BYTES" in ''|*[!0-9]*) ANDROID_BYTES=0 ;; esac
[ "$ANDROID_BYTES" -gt 0 ] || ANDROID_BYTES=1073741824
# rootfs + GSI are written once, straight from the zip, so that is the real peak. The zip
# and Android's own files are already counted as used by df. 1 GiB of headroom covers the
# ext4 metadata, the small metadata files and rounding.
NEED_KB=$(( (ROOTFS_BYTES + ANDROID_BYTES) / 1024 + 1048576 ))
AVAIL_KB="$(df -k /data 2>/dev/null | awk 'NR==2 {print $4}')"
case "$AVAIL_KB" in ''|*[!0-9]*) AVAIL_KB='' ;; esac
if [ -n "$AVAIL_KB" ]; then
    if [ "$AVAIL_KB" -lt "$NEED_KB" ]; then
        die "Not enough free space in /data: need $((NEED_KB/1024)) MiB, available $((AVAIL_KB/1024)) MiB. Free up space (delete files, or remove an older /data/rootfs.img) and retry."
    fi
    ui_print "[*] Free space check passed ($((AVAIL_KB/1024)) MiB available, $((NEED_KB/1024)) MiB needed)"
else
    ui_print "[!] Could not read the free space of /data, continuing anyway."
fi

# ---------------------------------------------------------------- check the zip
BOOT_IMG="$WORK/partitions/boot.img"
if ! unzip -o "$ZIPFILE" "partitions/boot.img" "$BUILD_PROP_REL" -d "$WORK" >/dev/null 2>"$ERR"; then
    die "Cannot unpack $ZIPFILE: $(tail -n 2 "$ERR" 2>/dev/null | tr '\n' ' ')"
fi
[ -s "$BOOT_IMG" ] || die "boot.img missing from the zip"
[ -s "$BUILD_PROP" ] || die "META-INF/sakura/build.prop missing from the zip"

# Both big entries are streamed later; make sure they are really in the archive first, so a
# bad zip fails here instead of halfway through a 4 GiB write.
for entry in images/rootfs.img.gz images/android-rootfs.img; do
    unzip -l "$ZIPFILE" "$entry" 2>/dev/null | grep -q "$entry" \
        || die "$entry missing from the zip"
done

# ---------------------------------------------------------------- backup boot
BOOT_PART=""
for p in /dev/block/by-name/boot /dev/block/bootdevice/by-name/boot; do
    if [ -e "$p" ]; then BOOT_PART="$p"; break; fi
done
[ -n "$BOOT_PART" ] || die "boot partition not found."

# build-zip.sh ships the real boot.img (~15-25 MB), never padded to the 64 MiB the device
# tree declares: some sakura units have a smaller boot partition, and the padded image made
# the flash fail with a size error. Because the image is not padded, a partition that is
# smaller than the image would mean it really does not fit, so verify the size first and
# refuse instead of writing past the end of the partition.
BOOT_IMG_BYTES="$(wc -c < "$BOOT_IMG")"
BOOT_NODE=""
if command -v readlink >/dev/null 2>&1; then
    BOOT_NODE="$(basename "$(readlink "$BOOT_PART" 2>/dev/null)" 2>/dev/null)"
fi
BOOT_SECTORS=""
[ -n "$BOOT_NODE" ] && BOOT_SECTORS="$(cat "/sys/class/block/$BOOT_NODE/size" 2>/dev/null)"
case "$BOOT_SECTORS" in ''|*[!0-9]*) BOOT_SECTORS='' ;; esac
if [ -n "$BOOT_SECTORS" ]; then
    BOOT_PART_BYTES=$((BOOT_SECTORS * 512))
    if [ "$BOOT_IMG_BYTES" -gt "$BOOT_PART_BYTES" ]; then
        die "boot.img is $BOOT_IMG_BYTES bytes but the boot partition is only $BOOT_PART_BYTES bytes."
    fi
    ui_print "[*] Boot image fits the partition ($BOOT_IMG_BYTES of $BOOT_PART_BYTES bytes, unpadded)"
else
    ui_print "[!] Could not read the boot partition size, writing $BOOT_IMG_BYTES bytes anyway."
fi

if [ -d /data/media/0 ]; then
    BACKUP_DIR="/data/media/0/sakura-ut-backup"
    mkdir -p "$BACKUP_DIR"
    if [ ! -s "$BACKUP_DIR/boot-stock.img" ]; then
        ui_print "[*] Backing up the current boot image to $BACKUP_DIR"
        if ! dd if="$BOOT_PART" of="$BACKUP_DIR/boot-stock.img" bs=1M 2>"$ERR"; then
            ui_print "[!] Could not back up the boot image: $(tail -n 1 "$ERR" 2>/dev/null)"
            ui_print "[!] Continuing, but keep your own copy of boot before rebooting."
        fi
    fi
fi

# ---------------------------------------------------------------- flash boot
ui_print "[*] Flashing Halium boot image to $BOOT_PART"
if ! dd if="$BOOT_IMG" of="$BOOT_PART" bs=1M 2>"$ERR"; then
    die "Failed to write the boot image: $(tail -n 2 "$ERR" 2>/dev/null | tr '\n' ' ')"
fi
sync

# ---------------------------------------------------------------- rootfs
# Streamed out of the zip: one write of rootfs + GSI, no second copy in /data.
ui_print "[*] Writing /data/rootfs.img (usually 2-4 minutes)..."
rm -f /data/rootfs.img
if ! unzip -p "$ZIPFILE" "images/rootfs.img.gz" 2>"$ERR" | gzip -dc > /data/rootfs.img 2>>"$ERR"; then
    rm -f /data/rootfs.img
    die "Failed to write /data/rootfs.img: $(tail -n 2 "$ERR" 2>/dev/null | tr '\n' ' ')"
fi
WROTE_BYTES="$(wc -c < /data/rootfs.img)"
if [ "$WROTE_BYTES" -lt "$ROOTFS_BYTES" ]; then
    rm -f /data/rootfs.img
    die "/data/rootfs.img is $WROTE_BYTES bytes, expected $ROOTFS_BYTES (out of space or a truncated zip)."
fi
sync

ui_print "[*] Writing /data/android-rootfs.img"
rm -f /data/android-rootfs.img
if ! unzip -p "$ZIPFILE" "images/android-rootfs.img" > /data/android-rootfs.img 2>"$ERR"; then
    die "Failed to write /data/android-rootfs.img: $(tail -n 2 "$ERR" 2>/dev/null | tr '\n' ' ')"
fi
WROTE_BYTES="$(wc -c < /data/android-rootfs.img)"
if [ "$WROTE_BYTES" -lt "$ANDROID_BYTES" ]; then
    die "/data/android-rootfs.img is $WROTE_BYTES bytes, expected $ANDROID_BYTES."
fi
# Stale images from a previous install would be mounted instead of ours.
rm -f /data/system.img 2>/dev/null || true

cp -f "$BUILD_PROP" /data/sakura-ubuntu-touch-build.prop 2>/dev/null || true

sync
ui_print "[*] Data written and synced."

# ---------------------------------------------------------------- done
ui_print ""
ui_print "[+] Ubuntu Touch 24.04 for sakura has been installed."
ui_print ""
ui_print "  Next steps:"
ui_print "   1. Reboot to system (do NOT reboot to recovery)."
ui_print "   2. First boot takes 5-10 minutes; the screen stays dark for a while."
ui_print "   3. To go back to Android: flash /sdcard/sakura-ut-backup/boot-stock.img"
ui_print "      from recovery, or 'fastboot flash boot boot-stock.img' on a PC."
ui_print ""
ui_print "  Single-boot: Android will not boot until you flash boot-stock.img back."
ui_print "  Its files in /data are untouched."
ui_print "  Install log saved to ${LOG:-the recovery log}"
ui_print ""
ui_print "*********************************************"

exit 0
