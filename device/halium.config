# Halium 10 kernel config fragment for Xiaomi Redmi 6 Pro (sakura), MSM8953, kernel 4.9.233
#
# Appended to arch/arm64/configs/sakura_defconfig by scripts/prepare-kernel-config.sh.
# The stock LineageOS 17.1 defconfig has DEVTMPFS, OVERLAY_FS, UTS_NS, PID_NS, USER_NS,
# MEMCG, VETH and SYSVIPC switched OFF, so this fragment has to turn them on for
# Ubuntu Touch to boot; everything else is left untouched so the Android-side drivers
# keep working.
#
# Reference: docs.ubports.com "Building the kernel" (Kernel config section) and
# gitlab.com/ubports/porting/community-ports/halium-generic-adaptation-build-tools.

## Android binder (libhybris talks to the Android HALs through it)
# binderfs is intentionally NOT enabled: this 4.9 tree does not contain
# drivers/android/binderfs.c, so CONFIG_ANDROID_BINDERFS does not exist and the option
# would be silently dropped. Halium 10 works with the classic binder devices, which the
# defconfig already provides through CONFIG_ANDROID_BINDER_DEVICES below.
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_ASHMEM=y

## Namespaces / containers: Ubuntu Touch runs the Android system in an LXC container
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_SYSVIPC=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_MEMCG=y
CONFIG_CPUSETS=y

## Filesystems the rootfs and the Android container need
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_CONFIGFS_FS=y
CONFIG_OVERLAY_FS=y

## Networking for LXC (veth pairs) and ofono/modem data
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_BRIDGE_NETFILTER=y

## Security
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DISABLE=y

## Debug/bring-up helpers that Halium images expect
CONFIG_KALLSYMS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
